      "title": "奶奶家·进门",
      "time": "下午",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_grandmother_house_entrance",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_homecoming_warm",
