    {
      "id": "b005",
      "title": "男高拒绝留下",
      "time": "梦境",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_dream_house_loop",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_nightmare_pressure",
