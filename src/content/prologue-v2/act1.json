    {
      "id": "a003",
      "title": "学校门口",
      "time": "清晨",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_school_gate_morning",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_school_morning",
          "placeholder": true
