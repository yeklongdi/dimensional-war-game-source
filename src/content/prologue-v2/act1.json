  "title": "序幕（二）：转学生来到太阳市第一高中",
  "scenes": [
    {
      "id": "a001",
      "title": "清晨睡过头",
      "time": "高二开学第一天清晨",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_grandmother_house_bedroom_morning",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_school_morning",
          "placeholder": true
