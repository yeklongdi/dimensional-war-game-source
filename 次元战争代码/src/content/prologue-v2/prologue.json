      "title": "仓库区外围·蒙面人离开",
      "time": "夜晚、战斗后",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_warehouse_area_night",
          "placeholder": true
        },
        {
          "kind": "bgm",
