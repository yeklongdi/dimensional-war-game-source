      "title": "警报与搜捕队",
      "time": "序幕三结束后，同一夜",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_grandmother_bedroom_night",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_after_dream_quiet",
