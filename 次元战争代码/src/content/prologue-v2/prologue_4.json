    {
      "id": "c003",
      "title": "第一次配合",
      "time": "同一夜，第一场战斗",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_old_district_access_night",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_first_partners_battle",
