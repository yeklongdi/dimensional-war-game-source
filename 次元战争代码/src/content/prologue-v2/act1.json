        },
        {
          "kind": "show",
          "actor": "男高",
          "asset": "char_male_high_normal",
          "position": "center",
          "placeholder": true,
          "pose": "拎着书包准备落座",
          "expression": "期待"
        },
        {
          "kind": "show",
