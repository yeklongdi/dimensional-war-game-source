      "id": "c002",
      "title": "出门与认出",
      "time": "同一夜",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_residential_junction_night",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_organization_tension",
          "placeholder": true
        },
        {
          "kind": "hide",
