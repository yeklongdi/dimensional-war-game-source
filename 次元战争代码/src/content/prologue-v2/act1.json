      "title": "教室·座位安排",
      "time": "上午",
      "nodes": [
        {
          "kind": "background",
          "name": "bg_school_classroom_morning",
          "placeholder": true
        },
        {
          "kind": "bgm",
          "name": "bgm_school_classroom_daily",
